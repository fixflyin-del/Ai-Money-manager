# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"
APP_URL="https://aimoneymanager.pro"
VITE_APP_URL="https://aimoneymanager.pro"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Server-Side)
# Required for: AI Chat (1/day free quota), Deep Smart Analysis, Daily Insights, Budget Plan
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyPlaceholder"
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
