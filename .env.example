# ==============================================================================
# FixFly AI Money Manager — Master Environment Variables (.env.example)
# Use this template for Vercel, Cloud Run, or local production deployments.
# IMPORTANT: Never commit actual secret keys or service account credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"
APP_URL="https://aimoney.fixfly.in"
VITE_APP_URL="https://aimoney.fixfly.in"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Server-Side)
# Required for: Gemini 2.5/Flash receipt scanning, voice expense parsing, AI chat & advice
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyPlaceholder"

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (Vite Client-Side: VITE_*)
# Used by: Firebase Authentication (Google popup) and Cloud Firestore client SDK
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyBpXW9VxQ5V1ou6IeQ47m4fDLLSj3h6NCw"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0045408045.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0045408045"
VITE_FIREBASE_DATABASE_ID="ai-studio-aimoneymanagerfi-46e8f392-ad6b-419a-96c0-8a673fdd4133"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0045408045.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="756303523586"
VITE_FIREBASE_APP_ID="1:756303523586:web:32e0af037e2f5d4ebfdc1b"
VITE_FIREBASE_OAUTH_CLIENT_ID="756303523586-f9o56r1dpmfhb7rgimrh26kp1rl9bmql.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK (Server-Side / Vercel Serverless Functions)
# Required for: Server-side token verification, administrative Firestore queries, and notifications
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="gen-lang-client-0045408045"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@gen-lang-client-0045408045.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. PAYU PAYMENT GATEWAY (Web & Global Subscriptions)
# Required for: Processing Indian & International payments on website
# ------------------------------------------------------------------------------
PAYU_MERCHANT_KEY="your_payu_merchant_key"
PAYU_MERCHANT_SALT="your_payu_merchant_salt"
PAYU_ENVIRONMENT="production" # Use 'test' for sandbox testing, 'production' for live

# ------------------------------------------------------------------------------
# 6. GOOGLE PLAY BILLING SERVICE ACCOUNT (Backend Purchase Verification)
# Required for: Server-side validation of Google Play Android purchase tokens via Android Publisher API
# ------------------------------------------------------------------------------
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL="play-billing@gen-lang-client-0045408045.iam.gserviceaccount.com"
GOOGLE_PLAY_PACKAGE_NAME="com.aimoneymanager.app"
